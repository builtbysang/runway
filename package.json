{
  "name": "runway-board",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "CLI-first agent runtime for Linear, Codex, Claude Code, GitHub, and Notion workflows.",
  "scripts": {
    "dev": "tsx cli.ts",
    "dev:codex": "RUNWAY_LLM_PROVIDER=codex-cli tsx cli.ts",
    "dev:claude": "RUNWAY_LLM_PROVIDER=claude-cli tsx cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.6.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "engines": {
    "node": "20.x"
  }
}
