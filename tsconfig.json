{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": false,
    "esModuleInterop": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "cli.ts",
    "agents/**/*.ts",
    "commands/**/*.ts",
    "lib/**/*.ts",
    "skills/**/*.ts",
    "projects.json"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
